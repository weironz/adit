* text=auto

*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# CRLF in these breaks something at runtime rather than merely looking wrong: a
# CRLF sshd_config breaks sshd, and a CRLF shebang sends the kernel looking for
# an interpreter named "bash\r". Neither is hypothetical — the packaging scripts
# run on the Linux and macOS runners, and a workflow file stored with CRLF cost a
# release when the release job restaged it normalised and the push was rejected
# for touching .github without permission. `* text=auto` above already normalises
# all of them; saying so explicitly is what keeps a later .gitattributes edit from
# quietly reclassifying them.
*.sh text eol=lf
docker/test-sshd/Dockerfile text eol=lf
docker/test-sshd/sshd_config text eol=lf
.github/** text eol=lf

*.exe binary
*.icns binary
*.ico binary
*.png binary
*.rgba binary

# Icon generator is a dev tool, not product code — keep it out of language stats.
assets/make_icon.py linguist-detectable=false

# The acceptance archives are compared byte for byte against their SHA-256
# manifest by the audit script, so a checkout has to deliver exactly the
# bytes the manifest describes, on Windows as well as on Linux.
#
# `text eol=lf` does that: the blob is stored with LF endings and every
# checkout is written with LF endings, so the digest the manifest records
# matches the file on disk everywhere. `-text` would also deliver the right
# bytes, but it would store whatever an editor happened to write - a CRLF
# from a Windows editor would be committed as-is and break the manifest.
#
# The raw bitmaps are binary and stay that way; the global `*.rgba` and
# `*.png` rules below cover them, and this block does not override them.
tests/rdp/results/**/*.md text eol=lf
tests/rdp/results/**/*.json text eol=lf
tests/rdp/results/**/*.jsonl text eol=lf
tests/rdp/results/**/*.py text eol=lf
