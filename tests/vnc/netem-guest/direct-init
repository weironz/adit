#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts
modprobe e1000
modprobe sch_netem
ip link set lo up
ip link set eth0 up
# Only the user-net host alias is reachable by this guest's unicast routing.
# QEMU restrict=off still permits other host ports via .2; this is no port ACL.
ip addr add 10.0.2.15/32 dev eth0
ip route add 10.0.2.2/32 dev eth0
test ! -e /etc/resolv.conf
exec /usr/bin/python3 -u /guest.py </dev/ttyS0 >/dev/ttyS0 2>&1
