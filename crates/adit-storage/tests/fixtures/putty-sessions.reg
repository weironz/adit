[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\proxied]
"HostName"="private.example.test"
"Protocol"="ssh"
"ProxyMethod"=dword:00000005
"ProxyTelnetCommand"="cmd.exe /c should-never-run"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\telnet]
